# --- Postgres (used by docker-compose AND Python scripts) ---
POSTGRES_USER=beip
POSTGRES_PASSWORD=beip_local_2024
POSTGRES_DB=beip_warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

